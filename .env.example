# =====================================================================
# UpShift Gig System - environment template
# Copy to .env and fill in YOUR OWN development values.
# NEVER commit .env. No UpShift production credentials are used anywhere.
# =====================================================================

# ---------- Runtime ----------
NODE_ENV=development
LOG_LEVEL=info                      # fatal|error|warn|info|debug|trace

# ---------- API (Fastify) ----------
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000   # back office, website
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-to-another-long-random-string
SESSION_TTL_MINUTES=480
PUBLIC_API_RATE_LIMIT_PER_MIN=120

# ---------- MySQL 8.0+ (your own dev database) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=upshift_gigs
DB_PASSWORD=change-me
DB_NAME=upshift_gigs_dev
DB_POOL_SIZE=10
DB_SSL=false
# Used only by `npm run db:create` / test setup (a user allowed to CREATE DATABASE / TRIGGER)
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# ---------- First admin (used ONLY by `npm run db:seed:admin`) ----------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=Admin

# ---------- AI provider (classification / verification assessor) ----------
# Leave LLM_API_KEY empty to run in rules-only mode: every uncertain gig goes to Needs Review.
LLM_PROVIDER=anthropic              # adapter key; provider is swappable
LLM_API_KEY=
LLM_MODEL=                          # set to a model id available to your key
LLM_TIMEOUT_MS=30000
LLM_MAX_OUTPUT_TOKENS=1000
LLM_PROMPT_VERSION=v1

# ---------- Discovery / verification (compliance controls) ----------
DISCOVERY_USER_AGENT=UpShiftGigBot/1.0 (+contact: you@example.com)
HTTP_TIMEOUT_MS=15000
MAX_CONCURRENT_FETCHES=4
DEFAULT_RATE_LIMIT_PER_MIN=10
RESPECT_ROBOTS_TXT=true             # must stay true; DB also enforces robots_respected = 1
RAW_CONTENT_MAX_BYTES=262144
RAW_CONTENT_RETENTION_DAYS=30

# ---------- Worker / scheduler ----------
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=2000
SCHEDULER_ENABLED=false
HEALTH_SWEEP_CRON=0 3 * * *

# ---------- Notifications ----------
NOTIFY_LEARNER_WEBHOOK_URL=         # optional; empty => events are stored as 'skipped'
NOTIFY_LEARNER_WEBHOOK_SECRET=
NOTIFY_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=gigs@example.com

# ---------- Website (Next.js, SSG/ISR) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:4000/public/v1   # server-side fetch for SSG/ISR
REVALIDATE_SECRET=change-me-shared-with-api
WEBSITE_REVALIDATE_URL=http://localhost:3000/api/revalidate   # API calls this on publish/unpublish
ISR_REVALIDATE_SECONDS=300

# ---------- Back office (Vite - only VITE_* is exposed to the browser; NO secrets here) ----------
VITE_API_BASE_URL=http://localhost:4000/api/v1
